	async deleteGithubCredentials(id: string): Promise<void> {
		return this.request<void>(`/github/credentials/${id}`, {
			method: 'DELETE'
		});
	}

	// Gitea Credentials
	async listGiteaCredentials(): Promise<ForgeCredentials[]> {
		return this.request<ForgeCredentials[]>('/gitea/credentials');
	}

	async getGiteaCredentials(id: string): Promise<ForgeCredentials> {
		return this.request<ForgeCredentials>(`/gitea/credentials/${id}`);
	}

	async createGiteaCredentials(params: CreateCredentialsParams): Promise<ForgeCredentials> {
		return this.request<ForgeCredentials>('/gitea/credentials', {
			method: 'POST',
			body: JSON.stringify(params)
		});
	}

	async updateGiteaCredentials(id: string, params: UpdateCredentialsParams): Promise<ForgeCredentials> {
		return this.request<ForgeCredentials>(`/gitea/credentials/${id}`, {
			method: 'PUT',
			body: JSON.stringify(params)
		});
	}

	async deleteGiteaCredentials(id: string): Promise<void> {
		return this.request<void>(`/gitea/credentials/${id}`, {
			method: 'DELETE'
		});
	}

	// Combined Credentials helper
	async listAllCredentials(): Promise<ForgeCredentials[]> {
		const [githubCredentials, giteaCredentials] = await Promise.all([
			this.listGithubCredentials().catch(() => []),
			this.listGiteaCredentials().catch(() => [])
		]);
		
		// The API already returns the correct structure with forge_type and endpoint fields
		return [...githubCredentials, ...giteaCredentials];
	}

	// Alias for backward compatibility
	async listCredentials(): Promise<ForgeCredentials[]> {
		return this.listAllCredentials();
	}

	// Alias for backward compatibility  
	async listEndpoints(): Promise<Endpoint[]> {
		return this.listAllEndpoints();
	}

